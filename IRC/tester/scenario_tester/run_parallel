#!/usr/bin/env bash

# run_parallel: Execute ./run_scenarios for each folder/subfolder in scenarios concurrently
# Usage: ./run_parallel [single|multi]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCENARIOS_DIR="${SCRIPT_DIR}/scenarios"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SERVER_BIN="${SERVER_BIN:-}"
if [ -z "$SERVER_BIN" ]; then
    if [ -x "${REPO_DIR}/ircserv" ]; then
        SERVER_BIN="${REPO_DIR}/ircserv"
    elif [ -x "${REPO_DIR}/ft_irc" ]; then
        SERVER_BIN="${REPO_DIR}/ft_irc"
    elif [ -x "$(cd "${SCRIPT_DIR}/.." && pwd)/ircserv" ]; then
        SERVER_BIN="$(cd "${SCRIPT_DIR}/.." && pwd)/ircserv"
    else
        SERVER_BIN="${REPO_DIR}/ircserv"
    fi
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

MODE="multi" # default mode
INCREMENTAL=0

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        single|one)
            MODE="single"
            ;;
        multi|multiple)
            MODE="multi"
            ;;
        -i|--incremental|-incremental|--live|-live|-interactive|--interactive|i|incremental|live)
            INCREMENTAL=1
            ;;
        -h|--help)
            echo "Usage: $0 [options] [single|multi]"
            echo ""
            echo "Options:"
            echo "  -i, --incremental  Print each completed test in real-time as they finish"
            echo "  -h, --help         Show this help message"
            echo ""
            echo "Modes:"
            echo "  single  Run all parallel test suites against a SINGLE shared server instance"
            echo "  multi   Run all parallel test suites on MULTIPLE isolated server instances (default)"
            exit 0
            ;;
        *)
            if [ -n "$arg" ]; then
                echo -e "${YELLOW}Warning: Unknown option/mode '$arg', defaulting to 'multi' (options: single, multi, -i)${NC}"
            fi
            ;;
    esac
done

if [ ! -d "$SCENARIOS_DIR" ]; then
    echo -e "${RED}Error: Scenarios directory not found at ${SCENARIOS_DIR}${NC}"
    exit 1
fi

# Find all directories that directly contain .spec files (leaf/target test suites)
FOLDERS=()
while IFS= read -r dir; do
    if [ -d "$dir" ]; then
        spec_count=$(find "$dir" -maxdepth 1 -type f -name '*.spec' | wc -l)
        if [ "$spec_count" -gt 0 ]; then
            rel_dir="${dir#${SCENARIOS_DIR}/}"
            FOLDERS+=("$rel_dir")
        fi
    fi
done < <(find "$SCENARIOS_DIR" -mindepth 1 -type d | sort)

if [ ${#FOLDERS[@]} -eq 0 ]; then
    echo -e "${RED}No scenario folders found in ${SCENARIOS_DIR}.${NC}"
    exit 1
fi

TMP_DIR=$(mktemp -d "/tmp/irc_parallel_test.XXXXXX")
SHARED_SERVER_PID=""

cleanup_exit() {
    trap - INT TERM EXIT
    if [ -n "$SHARED_SERVER_PID" ]; then
        kill "$SHARED_SERVER_PID" 2>/dev/null || true
        wait "$SHARED_SERVER_PID" 2>/dev/null || true
    fi
    kill $(jobs -p) 2>/dev/null || true
    rm -rf "$TMP_DIR"
}

on_interrupt() {
    trap - INT TERM EXIT
    echo -e "\n${YELLOW}Test run aborted by user (Ctrl+C). Cleaning up...${NC}"
    # Kill background subshells and processes immediately
    kill -9 $(jobs -p) 2>/dev/null || true
    if [ -n "$SHARED_SERVER_PID" ]; then
        kill -9 "$SHARED_SERVER_PID" 2>/dev/null || true
        wait "$SHARED_SERVER_PID" 2>/dev/null || true
    fi
    rm -rf "$TMP_DIR"
    exit 130
}

trap cleanup_exit EXIT
trap on_interrupt INT TERM

get_free_port() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket; s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.bind(('127.0.0.1', 0)); print(s.getsockname()[1]); s.close()"
    else
        shuf -i 20000-60000 -n 1
    fi
}

is_port_listening() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        if ss -tlnH "sport = :$port" 2>/dev/null | grep -q .; then
            return 0
        fi
    fi
    if command -v lsof >/dev/null 2>&1; then
        if lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
            return 0
        fi
    fi
    if command -v fuser >/dev/null 2>&1; then
        if fuser "$port/tcp" >/dev/null 2>&1; then
            return 0
        fi
    fi
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 2 127.0.0.1 "$port" 2>/dev/null
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket; s = socket.socket(); s.settimeout(2.0); s.connect(('127.0.0.1', int($port))); s.close()" 2>/dev/null
    elif (echo >/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

DEFAULT_PORT="6667"
DEFAULT_PASS="1234"

# Source .env if present
if [ -f "${REPO_DIR}/.env" ]; then
    # shellcheck disable=SC1090
    . "${REPO_DIR}/.env"
elif [ -f "${SCRIPT_DIR}/../.env" ]; then
    # shellcheck disable=SC1090
    . "${SCRIPT_DIR}/../.env"
elif [ -f "${SCRIPT_DIR}/.env" ]; then
    # shellcheck disable=SC1090
    . "${SCRIPT_DIR}/.env"
fi

DEFAULT_PORT="${PORT:-$DEFAULT_PORT}"
DEFAULT_PASS="${PASSWORD:-$DEFAULT_PASS}"

echo -e "\n${BOLD}${CYAN}======================================================================${NC}"
if [ "$MODE" = "single" ]; then
    echo -e "${BOLD}${CYAN}   RUNNING PARALLEL SUITES ON A SINGLE SERVER INSTANCE (${#FOLDERS[@]} SUITES) ${NC}"
else
    echo -e "${BOLD}${CYAN}  RUNNING PARALLEL SUITES ON MULTIPLE SERVER INSTANCES (${#FOLDERS[@]} SUITES) ${NC}"
fi
echo -e "${BOLD}${CYAN}======================================================================${NC}\n"

SHARED_PORT=""
SHARED_PASS="$DEFAULT_PASS"

if [ "$MODE" = "single" ]; then
    if is_port_listening "$DEFAULT_PORT"; then
        SHARED_PORT="$DEFAULT_PORT"
        echo -e "${GREEN}Using existing IRC server at 127.0.0.1:${SHARED_PORT}${NC}\n"
    else
        SHARED_PORT=$(get_free_port)

        # Build server if needed
        if [ ! -x "$SERVER_BIN" ]; then
            echo -e "${CYAN}Building server binary at ${REPO_DIR}...${NC}"
            make -C "$REPO_DIR" >/dev/null || { echo -e "${RED}Failed to build server${NC}"; exit 1; }
        fi

        # Start single shared server
        "$SERVER_BIN" "$SHARED_PORT" "$SHARED_PASS" >/dev/null 2>&1 &
        SHARED_SERVER_PID=$!

        started=0
        for (( i=0; i<50; i++ )); do
            if is_port_listening "$SHARED_PORT"; then
                started=1
                break
            fi
            if ! kill -0 "$SHARED_SERVER_PID" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done

        if [ "$started" -eq 1 ]; then
            echo -e "${GREEN}Started shared IRC server (PID: ${SHARED_SERVER_PID}) on port ${SHARED_PORT}${NC}\n"
        elif is_port_listening "$SHARED_PORT"; then
            SHARED_SERVER_PID=""
            echo -e "${GREEN}Using existing IRC server at 127.0.0.1:${SHARED_PORT}${NC}\n"
        else
            echo -e "${RED}Error: Failed to start shared IRC server on port ${SHARED_PORT}${NC}\n"
            exit 1
        fi
    fi
fi

PIDS=()
FOLDER_PORTS=()

for idx in "${!FOLDERS[@]}"; do
    folder="${FOLDERS[$idx]}"
    safe_name="${folder//\//__}"
    log_file="${TMP_DIR}/${safe_name}.log"
    port_file="${TMP_DIR}/${safe_name}.port"
    
    if [ "$MODE" = "single" ]; then
        port="$SHARED_PORT"
    else
        port=$(get_free_port)
    fi
    echo "$port" > "$port_file"
    FOLDER_PORTS[$idx]="$port"
    
    echo -e "  [RUNNING] ${BOLD}${folder}${NC} on port ${CYAN}${port}${NC}..."
    
    # Launch ./run_scenarios targeting this folder / subfolder
    (
        extra_flags=()
        if [ "$MODE" = "single" ]; then
            extra_flags+=(--password "$SHARED_PASS")
        fi
        if [ "$INCREMENTAL" -eq 1 ]; then
            "${SCRIPT_DIR}/run_scenarios" --port "$port" "${extra_flags[@]}" --dir "${SCENARIOS_DIR}/${folder}" 2>&1 | tee "$log_file" | grep --line-buffered -E '✅|❌|tester/logs/|Error:'
            echo "${PIPESTATUS[0]}" > "${TMP_DIR}/${safe_name}.exit"
        else
            "${SCRIPT_DIR}/run_scenarios" --port "$port" "${extra_flags[@]}" --dir "${SCENARIOS_DIR}/${folder}" > "$log_file" 2>&1
            echo $? > "${TMP_DIR}/${safe_name}.exit"
        fi
    ) &
    PIDS[$idx]=$!
done

if [ "$INCREMENTAL" -eq 1 ]; then
    echo -e "\n${CYAN}Running all ${#FOLDERS[@]} suites concurrently (printing completed tests live)...${NC}\n"
else
    echo -e "\n${CYAN}All ${#FOLDERS[@]} suites running concurrently in parallel (${MODE} server mode)...${NC}\n"
fi

# Wait for all background runs to complete
for pid in "${PIDS[@]}"; do
    wait "$pid" 2>/dev/null || true
done

FAILED_SUITES=0
TOTAL_SUITES=${#FOLDERS[@]}

for idx in "${!FOLDERS[@]}"; do
    folder="${FOLDERS[$idx]}"
    safe_name="${folder//\//__}"
    exit_code_file="${TMP_DIR}/${safe_name}.exit"
    exit_code=1
    [ -f "$exit_code_file" ] && exit_code=$(cat "$exit_code_file")
    if [ "$exit_code" -ne 0 ]; then
        FAILED_SUITES=$((FAILED_SUITES + 1))
    fi
done

if [ "$INCREMENTAL" -ne 1 ]; then
    echo -e "${BOLD}${CYAN}======================================================================${NC}"
    echo -e "${BOLD}${CYAN}                         SUITE RESULTS                                ${NC}"
    echo -e "${BOLD}${CYAN}======================================================================${NC}\n"

    for idx in "${!FOLDERS[@]}"; do
        folder="${FOLDERS[$idx]}"
        safe_name="${folder//\//__}"
        log_file="${TMP_DIR}/${safe_name}.log"

        echo -e "${BOLD}==================== [ SUITE: ${folder} (Port: ${FOLDER_PORTS[$idx]}) ] ====================${NC}"
        if [ -f "$log_file" ]; then
            cat "$log_file"
        else
            echo -e "${RED}No output captured for ${folder}.${NC}"
        fi
        echo ""
    done
elif [ "$FAILED_SUITES" -gt 0 ]; then
    echo -e "\n${BOLD}${RED}======================================================================${NC}"
    echo -e "${BOLD}${RED}                         FAILED SUITES                                ${NC}"
    echo -e "${BOLD}${RED}======================================================================${NC}\n"

    for idx in "${!FOLDERS[@]}"; do
        folder="${FOLDERS[$idx]}"
        safe_name="${folder//\//__}"
        log_file="${TMP_DIR}/${safe_name}.log"
        exit_code_file="${TMP_DIR}/${safe_name}.exit"
        exit_code=1
        [ -f "$exit_code_file" ] && exit_code=$(cat "$exit_code_file")

        if [ "$exit_code" -ne 0 ]; then
            echo -e "${BOLD}==================== [ SUITE: ${folder} (Port: ${FOLDER_PORTS[$idx]}) ] ====================${NC}"
            if [ -f "$log_file" ]; then
                cat "$log_file"
            else
                echo -e "${RED}No output captured for ${folder}.${NC}"
            fi
            echo ""
        fi
    done
else
    echo ""
fi

echo -e "${BOLD}======================================================================${NC}"
if [ $FAILED_SUITES -eq 0 ]; then
    echo -e "${GREEN}${BOLD}PARALLEL RUN SUCCESSFUL: All ${TOTAL_SUITES} suites passed!${NC}"
    echo -e "${BOLD}======================================================================${NC}\n"
    exit 0
else
    echo -e "${RED}${BOLD}PARALLEL RUN FAILED: ${FAILED_SUITES}/${TOTAL_SUITES} suites failed.${NC}"
    echo -e "${BOLD}======================================================================${NC}\n"
    exit 1
fi
