# 278_TOPIC_oversized_line_flood_disconnect.spec
# Tests adversarial line flood where client sends a line exceeding 512 bytes without \r\n.
# Expected: Server line limit guard triggers and disconnects the malicious client to prevent buffer exhaustion.
CLIENTS C1

C1 SEND PASS 1234
C1 SEND NICK Ali379
C1 SEND USER ali379 0 * :Ali379
C1 EXPECT 001 Ali379 :*

# Client sends oversized line > 512 bytes
C1 SEND TOPIC #boundary :
C1 EXPECT_DISCONNECT
