#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTRUNNER_BIN="${SCRIPT_DIR}/testrunner"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Build testrunner executable if missing
if [ ! -f "$TESTRUNNER_BIN" ]; then
    make -C "${SCRIPT_DIR}/.." || exit 1
fi

HOST="127.0.0.1"
PORT="6667"
PASSWORD="1234"
PORT_SRC="default"
PASS_SRC="default"

# Source .env if present (relative to repo root or script dir)
ENV_FILE=""
if [ -f "${SCRIPT_DIR}/../../.env" ]; then
    ENV_FILE="${SCRIPT_DIR}/../../.env"
elif [ -f "${SCRIPT_DIR}/../.env" ]; then
    ENV_FILE="${SCRIPT_DIR}/../.env"
elif [ -f "${SCRIPT_DIR}/.env" ]; then
    ENV_FILE="${SCRIPT_DIR}/.env"
fi

if [ -n "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    [ -n "${PORT:-}" ] && PORT_SRC=".env"
    [ -n "${PASSWORD:-}" ] && PASS_SRC=".env"
fi

# Load .testignore if present
IGNORE_PATTERNS=()
IGNORE_FILES=()
[ -f "${SCRIPT_DIR}/.testignore" ] && IGNORE_FILES+=("${SCRIPT_DIR}/.testignore")
[ -f "${SCRIPT_DIR}/../.testignore" ] && IGNORE_FILES+=("${SCRIPT_DIR}/../.testignore")
[ -f "${SCRIPT_DIR}/../../.testignore" ] && IGNORE_FILES+=("${SCRIPT_DIR}/../../.testignore")

for ifile in "${IGNORE_FILES[@]}"; do
    while IFS= read -r line || [ -n "$line" ]; do
        # Strip comments (#, //, ;)
        line="${line%%#*}"
        line="${line%%//*}"
        line="${line%%;*}"
        # Trim leading and trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [ -n "$line" ]; then
            IGNORE_PATTERNS+=("$line")
        fi
    done < "$ifile"
done

SERVER_PID=""
SCENARIOS_DIR="${SCRIPT_DIR}/scenarios"

is_spec_ignored() {
    local s="$1"
    [ ${#IGNORE_PATTERNS[@]} -eq 0 ] && return 1

    local rel_scenarios="${s#${SCENARIOS_DIR}/}"
    local rel_tester="${s#${SCRIPT_DIR}/}"
    local filename
    filename="$(basename "$s")"
    local basename="${filename%.spec}"

    for pat in "${IGNORE_PATTERNS[@]}"; do
        local clean_pat="${pat#./}"
        clean_pat="${clean_pat#/}"
        clean_pat="${clean_pat%/}"

        # 1. Exact or glob match on basename, filename, relative paths, or absolute path
        # shellcheck disable=SC2053
        if [[ "$basename" == $pat ]] || [[ "$filename" == $pat ]] || \
           [[ "$rel_scenarios" == $pat ]] || [[ "$rel_tester" == $pat ]] || \
           [[ "$s" == $pat ]]; then
            return 0
        fi

        # 2. Match with cleaned pattern
        # shellcheck disable=SC2053
        if [[ "$basename" == $clean_pat ]] || [[ "$filename" == $clean_pat ]] || \
           [[ "$rel_scenarios" == $clean_pat ]] || [[ "$rel_tester" == $clean_pat ]]; then
            return 0
        fi

        # 3. Match with .spec appended
        if [[ "$filename" == "${clean_pat}.spec" ]] || \
           [[ "$rel_scenarios" == "${clean_pat}.spec" ]] || \
           [[ "$rel_tester" == "${clean_pat}.spec" ]]; then
            return 0
        fi

        # 4. Directory or path segment match
        if [[ "$rel_scenarios" == ${clean_pat}/* ]] || [[ "$rel_tester" == ${clean_pat}/* ]] || \
           [[ "$rel_scenarios" == */${clean_pat}/* ]] || [[ "$rel_scenarios" == */${clean_pat} ]]; then
            return 0
        fi

        # 5. Prefix match for spec base / filename (e.g. "04_TOPIC")
        if [[ "$basename" == ${clean_pat}* ]] || [[ "$filename" == ${clean_pat}* ]]; then
            return 0
        fi
    done
    return 1
}

SPECS=()

add_spec_by_num() {
    local num_str="$1"
    # Format single digit to 2 digits (e.g. 1 -> 01)
    if [[ "$num_str" =~ ^[0-9]+$ ]]; then
        local formatted
        formatted=$(printf "%02d" "$num_str" 2>/dev/null || echo "$num_str")
        while IFS= read -r f; do
            if [ -f "$f" ]; then
                if [[ ! " ${SPECS[*]} " =~ " ${f} " ]]; then
                    SPECS+=("$f")
                    return 0
                fi
            fi
        done < <(find "$SCENARIOS_DIR" -type f -name "${formatted}*.spec" -o -type f -name "${num_str}*.spec" | sort)
    fi
    return 1
}

TARGET_DIRS=()
VERBOSE="${VERBOSE:-0}"
RAW_ARGS=()

add_specs_from_dir() {
    local target="$1"
    local matched=0
    local search_dirs=()

    # 1. Exact existing path (relative to pwd or absolute)
    if [ -d "$target" ]; then
        search_dirs+=("$(cd "$target" && pwd)")
    fi

    # Strip leading/trailing slashes for relative scenarios lookup (e.g. "/commands" or "commands/")
    local clean_target="${target#/}"
    clean_target="${clean_target%/}"

    if [ -n "$clean_target" ]; then
        # 2. Path relative to SCENARIOS_DIR
        if [ -d "${SCENARIOS_DIR}/${clean_target}" ]; then
            search_dirs+=("${SCENARIOS_DIR}/${clean_target}")
        elif [ -d "${clean_target}" ]; then
            search_dirs+=("$(cd "${clean_target}" && pwd)")
        else
            # 3. Case-insensitive or name match inside SCENARIOS_DIR
            while IFS= read -r d; do
                if [ -d "$d" ]; then
                    search_dirs+=("$d")
                fi
            done < <(find "$SCENARIOS_DIR" -type d \( -iname "$clean_target" -o -name "$clean_target" \) | sort)
        fi
    fi

    for d in "${search_dirs[@]}"; do
        while IFS= read -r f; do
            if [ -f "$f" ]; then
                if [[ ! " ${SPECS[*]} " =~ " ${f} " ]]; then
                    SPECS+=("$f")
                    matched=1
                fi
            fi
        done < <(find "$d" -type f -name '*.spec' | sort)
    done

    [ $matched -eq 1 ] && return 0
    return 1
}

show_help() {
    echo "Usage: $0 [options] [/folder|folder|scenario...]"
    echo ""
    echo "Options:"
    echo "  -d, --dir, --folder <dir>  Run all scenarios in the specified folder"
    echo "  -p, --password <pass>      IRC server password (default: 1234 or .env)"
    echo "  --port <port>              IRC server port (default: 6667 or .env)"
    echo "  -v, --verbose              Show full testrunner output for each scenario"
    echo "  -h, --help                 Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0                         # Run all scenarios"
    echo "  $0 /commands               # Run scenarios in 'commands' folder"
    echo "  $0 commands                # Run scenarios in 'commands' folder"
    echo "  $0 /channels/modes         # Run scenarios in 'channels/modes' folder"
    echo "  $0 --dir registration      # Run scenarios in 'registration' folder"
    echo "  $0 01                      # Run scenario starting with 01"
    echo "  $0 NICK                    # Run scenarios matching 'NICK'"
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        --v|-v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            show_help
            ;;
        -d|--dir|--folder)
            if [ -n "${2:-}" ]; then
                TARGET_DIRS+=("$2")
                shift 2
            else
                shift
            fi
            ;;
        --dir=*|--folder=*)
            TARGET_DIRS+=("${1#*=}")
            shift
            ;;
        -p|--password)
            if [ -n "${2:-}" ]; then
                PASSWORD="$2"
                PASS_SRC="arguments"
                shift 2
            else
                shift
            fi
            ;;
        -p=*|--password=*)
            PASSWORD="${1#*=}"
            PASS_SRC="arguments"
            shift
            ;;
        --port)
            if [ -n "${2:-}" ]; then
                PORT="$2"
                PORT_SRC="arguments"
                shift 2
            else
                shift
            fi
            ;;
        --port=*)
            PORT="${1#*=}"
            PORT_SRC="arguments"
            shift
            ;;
        *)
            RAW_ARGS+=("$1")
            shift
            ;;
    esac
done

# 1. Add specs from explicitly specified target directories (--dir / --folder)
for tdir in "${TARGET_DIRS[@]}"; do
    if ! add_specs_from_dir "$tdir"; then
        echo -e "${RED}Warning: No .spec files found in directory '${tdir}'.${NC}"
    fi
done

# 2. Process positional arguments (folders, test numbers, filenames, or patterns)
if [ ${#RAW_ARGS[@]} -gt 0 ]; then
    for arg in "${RAW_ARGS[@]}"; do
        # Exact .spec file path
        if [ -f "$arg" ] && [[ "$arg" == *.spec ]]; then
            abs_f="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
            if [[ ! " ${SPECS[*]} " =~ " ${abs_f} " ]]; then
                SPECS+=("$abs_f")
            fi
        # Directory name or path
        elif add_specs_from_dir "$arg"; then
            :
        # Number prefix match (e.g. "01", "1")
        elif add_spec_by_num "$arg"; then
            :
        # Multi-digit sequence (e.g. "12" -> 01 and 02) if not a 4-5 digit port
        elif [[ "$arg" =~ ^[0-9]+$ ]] && [ ${#arg} -gt 1 ] && ! [[ "$arg" =~ ^[0-9]{4,5}$ ]]; then
            for (( i=0; i<${#arg}; i++ )); do
                digit="${arg:$i:1}"
                add_spec_by_num "$digit"
            done
        else
            # Substring / pattern glob search in SCENARIOS_DIR
            matched_spec=0
            while IFS= read -r f; do
                if [ -f "$f" ]; then
                    if [[ ! " ${SPECS[*]} " =~ " ${f} " ]]; then
                        SPECS+=("$f")
                        matched_spec=1
                    fi
                fi
            done < <(find "$SCENARIOS_DIR" -type f -name "*${arg}*.spec" | sort)
            if [ $matched_spec -eq 0 ]; then
                echo -e "${RED}Warning: No matching scenario or directory found for '${arg}'.${NC}"
            fi
        fi
    done
elif [ ${#TARGET_DIRS[@]} -eq 0 ]; then
    # Without args and without target dirs: run all specs
    while IFS= read -r f; do
        if [ -f "$f" ]; then
            SPECS+=("$f")
        fi
    done < <(find "$SCENARIOS_DIR" -type f -name '*.spec' | sort)
fi

if [ ${#IGNORE_PATTERNS[@]} -gt 0 ]; then
    FILTERED_SPECS=()
    IGNORED_COUNT=0
    for s in "${SPECS[@]}"; do
        if is_spec_ignored "$s"; then
            IGNORED_COUNT=$((IGNORED_COUNT + 1))
        else
            FILTERED_SPECS+=("$s")
        fi
    done
    SPECS=("${FILTERED_SPECS[@]}")
fi

if [ ${#SPECS[@]} -eq 0 ]; then
    if [ ${IGNORED_COUNT:-0} -gt 0 ]; then
        echo "All matching test scenarios were ignored via .testignore (${IGNORED_COUNT} ignored)."
        exit 0
    else
        echo "No matching test spec files found to execute."
        exit 1
    fi
fi

format_folder_title() {
    local dir="$1"
    if [ "$dir" = "." ] || [ -z "$dir" ]; then
        echo "Scenarios"
        return
    fi
    local result=""
    IFS='/' read -ra PARTS <<< "$dir"
    for part in "${PARTS[@]}"; do
        local with_spaces="${part//_/ }"
        with_spaces="${with_spaces//-/ }"
        local part_title=""
        for word in $with_spaces; do
            local cap
            cap="$(printf '%s' "${word:0:1}" | tr '[:lower:]' '[:upper:]')${word:1}"
            if [ -z "$part_title" ]; then
                part_title="$cap"
            else
                part_title="$part_title $cap"
            fi
        done
        if [ -z "$result" ]; then
            result="$part_title"
        else
            result="$result / $part_title"
        fi
    done
    echo "$result"
}

format_test_name() {
    local base="$1"
    local with_spaces="${base//_/ }"
    with_spaces="${with_spaces//-/ }"
    local title=""
    for word in $with_spaces; do
        local cap
        cap="$(printf '%s' "${word:0:1}" | tr '[:lower:]' '[:upper:]')${word:1}"
        if [ -z "$title" ]; then
            title="$cap"
        else
            title="$title $cap"
        fi
    done
    echo "$title"
}

cleanup() {
    trap - INT TERM EXIT
    if [ -n "$SERVER_PID" ]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    exit 130
}

trap cleanup INT TERM

format_config_source() {
    if [ "$PORT_SRC" = "$PASS_SRC" ]; then
        case "$PORT_SRC" in
            "arguments") echo "arguments" ;;
            ".env") echo ".env file" ;;
            *) echo "defaults" ;;
        esac
    else
        echo "arguments/defaults/.env (Port from ${PORT_SRC}, Password from ${PASS_SRC})"
    fi
}

SRC_LABEL=$(format_config_source)
echo -e "${CYAN}Using config from ${SRC_LABEL}.${NC}"
echo -e "${CYAN}Port: ${PORT} Password: ${PASSWORD}${NC}"

is_server_listening() {
    local target_host="${1:-$HOST}"
    local target_port="${2:-$PORT}"

    # For localhost / loopback, check OS kernel socket state first (instant and immune to high load / valgrind lag)
    case "$target_host" in
        "127.0.0.1"|"localhost"|"::1"|"0.0.0.0"|"")
            if command -v ss >/dev/null 2>&1; then
                if ss -tlnH "sport = :$target_port" 2>/dev/null | grep -q .; then
                    return 0
                fi
            fi
            if command -v lsof >/dev/null 2>&1; then
                if lsof -iTCP:"$target_port" -sTCP:LISTEN >/dev/null 2>&1; then
                    return 0
                fi
            fi
            if command -v fuser >/dev/null 2>&1; then
                if fuser "$target_port/tcp" >/dev/null 2>&1; then
                    return 0
                fi
            fi
            ;;
    esac

    # Fallback to active TCP probe with 2s timeout
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 2 "$target_host" "$target_port" 2>/dev/null
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket; s = socket.socket(); s.settimeout(2.0); s.connect(('$target_host', int($target_port))); s.close()" 2>/dev/null
    elif (echo >/dev/tcp/"$target_host"/"$target_port") 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SERVER_BIN="${SERVER_BIN:-}"
if [ -z "$SERVER_BIN" ]; then
    if [ -x "${REPO_DIR}/ircserv" ]; then
        SERVER_BIN="${REPO_DIR}/ircserv"
    elif [ -x "${REPO_DIR}/ft_irc" ]; then
        SERVER_BIN="${REPO_DIR}/ft_irc"
    elif [ -x "$(cd "${SCRIPT_DIR}/.." && pwd)/ircserv" ]; then
        SERVER_BIN="$(cd "${SCRIPT_DIR}/.." && pwd)/ircserv"
    else
        SERVER_BIN="${REPO_DIR}/ircserv"
    fi
fi

if is_server_listening; then
    echo -e "${GREEN}Using existing IRC server at ${HOST}:${PORT}${NC}\n"
else
    # Build server binary if missing
    if [ ! -x "$SERVER_BIN" ]; then
        echo -e "${CYAN}Building server binary at ${REPO_DIR}...${NC}"
        make -C "$REPO_DIR" >/dev/null || {
            echo -e "${RED}${BOLD}Failed to build IRC server at ${REPO_DIR}${NC}"
            exit 1
        }
    fi

    read -r -a EXTRA_ARGS <<< "${SERVER_EXTRA_ARGS:-}"
    "$SERVER_BIN" "$PORT" "${PASSWORD:-}" "${EXTRA_ARGS[@]}" >/dev/null 2>&1 &
    SERVER_PID=$!
    trap 'if [ -n "$SERVER_PID" ]; then kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; fi' EXIT

    # Wait up to 5 seconds for server to start listening
    started=0
    for (( i=0; i<50; i++ )); do
        if is_server_listening; then
            started=1
            break
        fi
        # If server process died prematurely
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done

    if [ "$started" -eq 1 ]; then
        echo -e "${GREEN}Started new IRC server (PID: ${SERVER_PID}) at ${HOST}:${PORT}${NC}\n"
    elif is_server_listening; then
        # If the spawned process exited (e.g. port collision race), but the port is active,
        # fallback to using the existing server on that port
        SERVER_PID=""
        echo -e "${GREEN}Using existing IRC server at ${HOST}:${PORT}${NC}\n"
    else
        echo -e "${RED}${BOLD}Error: Failed to start IRC server at ${HOST}:${PORT}.${NC}\n"
        exit 1
    fi
fi

failed=0
total=0
current_dir=""

cd "$SCRIPT_DIR"

for spec in "${SPECS[@]}"; do
    total=$((total + 1))
    rel_spec="${spec#${SCENARIOS_DIR}/}"
    dir_name="$(dirname "$rel_spec")"
    spec_file="$(basename "$spec")"
    spec_base="${spec_file%.spec}"

    if [ "$dir_name" != "$current_dir" ]; then
        current_dir="$dir_name"
        folder_title=$(format_folder_title "$dir_name")
        if [ $total -gt 1 ]; then
            echo ""
        fi
        echo -e "${BOLD}== ${folder_title} ==${NC}"
    fi

    test_name=$(format_test_name "$spec_base")
    RUNNER_ARGS=(--host "$HOST" --port "$PORT")
    if [ -n "$PASSWORD" ]; then
        RUNNER_ARGS+=(--password "$PASSWORD")
    fi
    if [ "$VERBOSE" -eq 1 ]; then
        RUNNER_ARGS+=(--v)
    fi
    output=$("$TESTRUNNER_BIN" "${RUNNER_ARGS[@]}" "$spec" 2>&1)
    status=$?

    # If the test process was killed by a signal (SIGINT=130, SIGQUIT=131, SIGTERM=143, etc.), abort immediately
    if [ $status -ge 128 ]; then
        cleanup
    fi

    # If the server process died, abort immediately instead of failing remaining tests
    if [ -n "$SERVER_PID" ] && ! kill -0 "$SERVER_PID" 2>/dev/null; then
        cleanup
    fi

    if [ "$VERBOSE" -eq 1 ]; then
        echo -e "${BOLD}--- [${spec_base}] ---${NC}"
        echo "$output"
        echo ""
    fi

    if [ $status -eq 0 ]; then
        echo -e "${GREEN}${test_name}   ✅${NC}"
    else
        failed=$((failed + 1))
        err_msg=$(echo "$output" | grep -E '^FAIL \[' | head -n 1 | sed -E 's/^FAIL \[[^]]*\] //')
        if [ -z "$err_msg" ]; then
            err_msg=$(echo "$output" | grep -v '^[[:space:]]*$' | head -n 1)
        fi
        if [ -n "$err_msg" ]; then
            echo -e "${RED}${test_name}   ❌   ${err_msg}${NC}"
        else
            echo -e "${RED}${test_name}   ❌${NC}"
        fi
        echo -e "   ${RED}\033[4mtester/logs/${spec_base}.log${NC}\n"
    fi
    sleep 0.05
done

echo ""
echo "----------------------------------------"
if [ $failed -eq 0 ]; then
    echo -e "${GREEN}Summary: $((total - failed))/$total scenarios passed.${NC}"
else
    echo -e "${RED}Summary: $((total - failed))/$total scenarios passed.${NC}"
fi

if [ $failed -gt 0 ]; then
    exit 1
fi
